{
  "name": "doomsday-countdown",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-static-routes.mjs && node scripts/test-static-routes.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "rm -rf .test-dist && tsc -p tsconfig.test.json && node .test-dist/test/runner.js",
    "validate:content": "node scripts/validate-drafts.mjs"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.2.2",
    "vite": "^5.1.7",
    "@types/react": "^18.2.28",
    "@types/react-dom": "^18.2.11"
  }
}
